+    if (durationMs !== undefined) entry.message.durationMs = durationMs;
+    return entry;
+  };
+  const stats = computeSessionStats([
+    userEntry("u1", null),
+    withDuration("a1", "u1", 2000),
+    userEntry("u2", "a1"),
+    withDuration("a2", "u2", 3000),
+    // A reply without a recorded duration must contribute 0, not NaN.
+    withDuration("a3", "a2", undefined),
+  ]);
+  assert.equal(stats.generationMs, 5000);
+  assert.equal(stats.tokens.output, 15);
+});
