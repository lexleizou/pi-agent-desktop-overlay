+  // mergeSessionStats takes unwrapped AgentMessages (what the hook passes),
+  // not session entries.
+  const merged = mergeSessionStats(file, [loadedA.message], [liveA.message]);
+  assert.equal(merged.generationMs, 5500);
+});
